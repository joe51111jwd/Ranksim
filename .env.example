# Copy to .env. Defaults run fully offline with labeled mocks.

DATABASE_URL=sqlite:///./data/aeo.db

# auto uses Brave when BRAVE_API_KEY is set, otherwise the labeled mock.
SEARCH_PROVIDER=auto
BRAVE_API_KEY=

# Google rank simulator. Live Google order needs SerpAPI or DataForSEO.
# Brave is a non-Google fallback. Leave these blank to refuse invented ranks.
SERPAPI_KEY=
# Serper is the practical key for collecting 300+ Google queries. DataForSEO is the other Google option.
SERPER_API_KEY=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# AI layer. The first key that is set wins: OpenRouter, then OpenAI, then Anthropic.
# An OPENAI_API_KEY that starts with sk-or- is sent to OpenRouter.
# Default model is openai/gpt-4o-mini on OpenRouter, gpt-4o-mini on OpenAI, or claude-3-5-haiku-20241022.
# Override the model with RANKSIM_LLM_MODEL.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
RANKSIM_LLM_MODEL=
# Per-process ceilings on LLM requests sent and estimated dollars. Over the cap, calls fall back to templates.
# The dollar cap needs a published rate for the model (see LIST_RATES in llm.py); for an unpriced model
# it stops after the first call. Set RANKSIM_LLM_MAX_USD=0 to rely on the request cap alone.
RANKSIM_LLM_MAX_CALLS=200
RANKSIM_LLM_MAX_USD=1.00
RANKSIM_DATABASE_URL=sqlite:///./data/ranksim.db
RANKSIM_SERP_DEPTH=10
RANKSIM_MAX_PAGES=1000
# off, or dataforseo to store a backlink rank when those credentials exist.
RANKSIM_AUTHORITY=off

# auto uses an OpenAI-compatible chat API when OPENAI_API_KEY is set, otherwise the labeled mock.
LLM_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Hashing embeddings are 64 dimensions. API embeddings need the model's real size,
# for example EMBEDDING_PROVIDER=openai and EMBEDDING_DIM=1536.
EMBEDDING_PROVIDER=auto
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=64

# true runs jobs inside the API process. Leave the worker off in that case.
PROCESS_JOBS_INLINE=false
WORKER_POLL_SECONDS=1

CRAWL_DELAY_SECONDS=0.25
CRAWL_ALLOW_PRIVATE=false
# Required before crawling third-party sites: your crawler's name and a contact URL or email that site
# owners can reach. The example.com placeholder below is refused.
CRAWL_USER_AGENT=AEOSimulatorBot/0.1 (+https://example.com/aeo-simulator)
# LLM provider for ranksim: auto (by which key is set), openrouter, openai or anthropic.
RANKSIM_LLM_PROVIDER=auto
