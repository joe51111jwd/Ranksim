  "components": {
    "schemas": {
      "ABIn": {
        "properties": {
          "change_type": {
            "type": "string",
            "title": "Change Type"
          },
          "page_url": {
            "type": "string",
            "title": "Page Url"
          },
          "html": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1500000
              },
              {
                "type": "null"
              }
            ],
            "title": "Html"
          }
        },
        "type": "object",
        "required": [
          "change_type",
          "page_url"
        ],
        "title": "ABIn"
      },
      "CalibrationIn": {
        "properties": {
          "engine": {
            "type": "string",
            "title": "Engine"
          },
          "cited": {
            "type": "boolean",
            "title": "Cited"
          },
          "mentioned": {
            "type": "boolean",
            "title": "Mentioned"
          },
          "citation_position": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 20.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Citation Position"
          },
          "question_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Question Id"
          },
          "notes": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ],
            "title": "Notes"
          }
        },
        "type": "object",
        "required": [
          "engine",
          "cited",
          "mentioned"
        ],
        "title": "CalibrationIn"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "QuestionsIn": {
        "properties": {
          "questions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 10,
            "minItems": 1,
            "title": "Questions"
          },
          "n_runs": {
            "type": "integer",
            "maximum": 10.0,
            "minimum": 1.0,
            "title": "N Runs",
            "default": 5
          },
          "fetch_competitors": {
            "type": "boolean",
            "title": "Fetch Competitors",
            "default": true
          },
          "search_provider": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Search Provider"
          },
          "llm_provider": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Llm Provider"
          },
          "embedding_provider": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Embedding Provider"
          }
        },
        "type": "object",
        "required": [
          "questions"
        ],
        "title": "QuestionsIn"
      },
      "SeedPageIn": {
        "properties": {
          "url": {
            "type": "string",
            "title": "Url"
          },
          "html": {
            "type": "string",
            "maxLength": 1500000,
            "minLength": 1,
            "title": "Html"
          }
        },
        "type": "object",
        "required": [
          "url",
          "html"
        ],
        "title": "SeedPageIn"
      },
      "SimulationIn": {
        "properties": {
          "site_url": {
            "type": "string",
            "title": "Site Url"
          },
          "sitemap_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sitemap Url"
          },
          "pages": {
            "items": {
              "$ref": "#/components/schemas/SeedPageIn"
            },
            "type": "array",
            "maxItems": 50,
            "title": "Pages"
          },
          "questions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 10,
            "minItems": 1,
            "title": "Questions"
          },
          "n_runs": {
            "type": "integer",
            "maximum": 10.0,
            "minimum": 1.0,
            "title": "N Runs",
            "default": 5
          },
          "max_pages": {
            "type": "integer",
            "maximum": 50.0,
            "minimum": 1.0,
            "title": "Max Pages",
            "default": 20
          },
          "render_js": {
            "type": "boolean",
            "title": "Render Js",
            "default": false
          },
          "fetch_competitors": {
            "type": "boolean",
            "title": "Fetch Competitors",
            "default": true
          },
          "search_provider": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Search Provider"
          },
          "llm_provider": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Llm Provider"
          },
          "embedding_provider": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Embedding Provider"
          }
        },
        "type": "object",
        "required": [
          "site_url",
          "questions"
        ],
        "title": "SimulationIn"
      },
      "SiteIn": {
        "properties": {
          "url": {
            "type": "string",
            "title": "Url"
          },
          "sitemap_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sitemap Url"
          },
          "pages": {
            "items": {
              "$ref": "#/components/schemas/SeedPageIn"
            },
            "type": "array",
            "maxItems": 50,
            "title": "Pages"
          },
          "max_pages": {
            "type": "integer",
            "maximum": 50.0,
            "minimum": 1.0,
            "title": "Max Pages",
            "default": 20
          },
          "render_js": {
            "type": "boolean",
            "title": "Render Js",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "url"
        ],
        "title": "SiteIn"
